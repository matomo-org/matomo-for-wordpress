<div id="embeddedmatomo">
    <script>
      window.addEventListener('DOMContentLoaded', function () {
        var AjaxHelper = window.CoreHome.AjaxHelper;
        var oldSend = AjaxHelper.prototype.send;
        AjaxHelper.prototype.send = function () {
          if (this.getUrl === '?' || this.getUrl === 'index.php?') {
            this.getUrl = {{ matomoIndexPhpUrl|json_encode|raw }} + '?';
          }
          return oldSend.apply(this, [].slice.call(arguments));
        };
      }, true);
    </script>

    {% include "_jsGlobalVariables.twig" %}
    {% include "_jsCssIncludes.twig" %}

    <div id="root">
        {% block content %}
        {% endblock %}
    </div>
</div>
