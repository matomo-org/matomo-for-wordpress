<Files ~ "^get-matomo-tables.php$">
<IfModule mod_version.c>
	<IfVersion < 2.4>
        Order allow,deny
        Allow from all
	</IfVersion>
	<IfVersion >= 2.4>
		Require all granted
	</IfVersion>
</IfModule>
<IfModule !mod_version.c>
	<IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
	</IfModule>
	<IfModule mod_authz_core.c>
		Require all granted
	</IfModule>
</IfModule>
</Files>
